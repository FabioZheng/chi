LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Assumption-Aware Agent Planner

# Optional OpenAI fallback. Set LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Planning speed: two planner agents run in parallel (one itinerary option each)
# and merge their results. Set to 0 to fall back to a single sequential planner call.
PARALLEL_PLANNER=1

# Optional Google Maps Platform key for real geocoding and route geometry.
# Copy this file to .env locally and paste a temporary key there. Do not commit real keys.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Browser key for the interactive Google Map (Maps JavaScript API must be enabled).
# May be the same value as GOOGLE_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
