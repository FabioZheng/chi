LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Set this to the production or preview URL. On Vercel, the app also falls back
# to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL when this is left empty.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=TripTree

# Optional OpenAI fallback. Set LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Legacy non-skeleton requests can run two planner variants in parallel. The
# active TripTree flow always sends a committed skeleton and makes one planner call.
# Set to 0 to force one planner call for every request.
PARALLEL_PLANNER=1

# Optional Google Maps Platform key for real geocoding and route geometry.
# Copy this file to .env locally and paste a temporary key there. Do not commit real keys.
GOOGLE_MAPS_API_KEY=

# Browser key for the interactive Google Map (Maps JavaScript API must be enabled).
# Use a separate key with HTTP-referrer restrictions. Never reuse the server key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
